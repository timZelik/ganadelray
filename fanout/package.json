{
  "name": "fanout",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck --continue",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @fanout/web test:e2e",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration",
    "db:generate": "pnpm --filter @fanout/database db:generate",
    "db:migrate": "pnpm --filter @fanout/database db:migrate",
    "db:seed": "pnpm --filter @fanout/database db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.7.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
