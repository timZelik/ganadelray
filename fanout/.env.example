# Copy to .env. Every value has a development default in docker-compose.yml; set real ones before exposing anything.

# Set to production for any deployment others can reach. The app then refuses the development encryption key.
NODE_ENV=development
LOG_LEVEL=info

# Encrypts OAuth tokens at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Losing it means reconnecting every account; changing it invalidates stored tokens.
TOKEN_ENCRYPTION_KEY=

POSTGRES_PASSWORD=change-me

# Storage. Development uses the bundled SeaweedFS. For Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT=   (leave empty unless presigned URLs must use another host)
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=http://s3:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=fanout
S3_ACCESS_KEY_ID=fanout
S3_SECRET_ACCESS_KEY=change-me

# true: every publisher validates, renders and builds its request, then logs it instead of posting.
PUBLISH_DRY_RUN=true
WATCH_INTERVAL_SECONDS=10
RENDERED_ASSET_RETENTION_DAYS=7

# Public hostname for automatic HTTPS via Caddy, e.g. fanout.example.com. Default serves HTTP on HTTP_PORT.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
